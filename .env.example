# Server
# development | production (production enables Secure + SameSite=None cookies)
APP_ENV=development
PORT=3000
CLIENT_URL=http://localhost:4200

# MongoDB (local single-node replica set: make docker-up)
DB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
DB_NAME=synaptic

# JWT (durations use the legacy compact syntax: ms, s, m, h, d)
JWT_SECRET=change-me
JWT_ISSUER=synaptic-api
JWT_AUDIENCE=synaptic-web
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Together AI
TOGETHER_API_KEY=change-me
