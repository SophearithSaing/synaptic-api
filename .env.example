# Server
# development | production (production enables Secure + SameSite=None cookies)
APP_ENV=development
PORT=3000
CLIENT_URL=http://localhost:4200

# DB
DB_URL=postgresql//

# JWT (Go durations, e.g. 15m or 168h)
JWT_SECRET=change-me
JWT_ISSUER=synaptic-api
JWT_AUDIENCE=synaptic-web
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=168h # 7 days

# Together AI
TOGETHER_API_KEY=change-me
