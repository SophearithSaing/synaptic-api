      "x-csrf-token": "<csrfToken:01>"
    },
    "body": {
      "username": "carol",
      "email": "carol@example.com",
      "password": "Password1",
      "role": "admin"
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
