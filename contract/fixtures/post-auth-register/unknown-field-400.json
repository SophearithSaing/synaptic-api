{
  "route": "POST /auth/register",
  "case": "unknown-field-400",
  "note": "forbidNonWhitelisted rejects the unknown `role` property.",
  "request": {
    "method": "POST",
    "path": "/auth/register",
    "headers": {
      "content-type": "application/json",
