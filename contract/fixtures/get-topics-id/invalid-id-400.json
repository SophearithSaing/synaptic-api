{
  "route": "GET /topics/{id}",
  "case": "invalid-id-400",
  "request": {
    "method": "GET",
    "path": "/topics/not-an-id",
    "headers": {
      "cookie": "csrf_token=<csrfToken:05>; access_token=<jwt>"
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "message": "Invalid MongoDB ObjectId",
      "error": "Bad Request",
      "statusCode": 400
    }
  }
}
