    "path": "/sessions/live/not-an-id",
    "headers": {
      "cookie": "csrf_token=<csrfToken:05>; access_token=<jwt>",
      "x-csrf-token": "<csrfToken:05>"
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
