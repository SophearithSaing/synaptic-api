{
  "route": "POST /auth/refresh",
  "case": "csrf-403",
  "request": {
    "method": "POST",
    "path": "/auth/refresh",
    "headers": {
      "cookie": "csrf_token=<csrfToken:05>; access_token=<jwt>; refresh_token=<refreshToken:06>"
    }
  },
  "response": {
    "status": 403,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "message": "Invalid CSRF token",
      "error": "Forbidden",
      "statusCode": 403
    }
  }
}
