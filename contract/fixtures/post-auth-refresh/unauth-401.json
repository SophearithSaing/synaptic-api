{
  "route": "POST /auth/refresh",
  "case": "unauth-401",
  "note": "No refresh_token cookie present.",
  "request": {
    "method": "POST",
    "path": "/auth/refresh",
    "headers": {
      "cookie": "csrf_token=<csrfToken:06>",
      "x-csrf-token": "<csrfToken:06>"
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "message": "Unauthorized",
      "statusCode": 401
    }
  }
}
