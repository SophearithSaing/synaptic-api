{
  "route": "POST /auth/login",
  "case": "wrong-password-401",
  "request": {
    "method": "POST",
    "path": "/auth/login",
    "headers": {
      "content-type": "application/json",
      "cookie": "csrf_token=<csrfToken:03>; access_token=<jwt>; refresh_token=<refreshToken:03>",
      "x-csrf-token": "<csrfToken:03>"
    },
    "body": {
      "identifier": "student",
      "password": "WrongPass1"
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "message": "Unauthorized",
      "statusCode": 401
    }
  }
}
