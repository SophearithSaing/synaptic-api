{
  "route": "GET /categories/{id}",
  "case": "not-found-404",
  "request": {
    "method": "GET",
    "path": "/categories/<objectId:08>",
    "headers": {
      "cookie": "csrf_token=<csrfToken:05>; access_token=<jwt>"
    }
  },
  "response": {
    "status": 404,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "message": "Category not found",
      "error": "Not Found",
      "statusCode": 404
    }
  }
}
