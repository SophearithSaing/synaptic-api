{
  "route": "POST /categories/category/create",
  "case": "validation-400",
  "request": {
    "method": "POST",
    "path": "/categories/category/create",
    "headers": {
      "content-type": "application/json",
      "cookie": "csrf_token=<csrfToken:09>; access_token=<jwt>",
      "x-csrf-token": "<csrfToken:09>"
    },
    "body": {
      "title": "No Icon",
      "slug": "no-icon",
      "description": "Missing."
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "message": ["icon should not be empty", "icon must be a string"],
      "error": "Bad Request",
      "statusCode": 400
    }
  }
}
